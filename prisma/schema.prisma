generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ShippingProvider {
  DELHIVERY
  MANUAL
}

enum ShippingMode {
  SURFACE
  EXPRESS
}

enum ShipmentStatus {
  NOT_CREATED
  QUOTED
  CREATED
  PICKUP_SCHEDULED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
  CANCELLED
  FAILED
}

enum OtpPurpose {
  ORDER_TRACKING
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  phone    String?

  role Role @default(CUSTOMER)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([createdAt])
}

model Admin {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Category {
  id    String  @id @default(cuid())
  name  String
  slug  String  @unique
  image String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
}

model Product {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String

  price Decimal @db.Decimal(10, 2)

  image String

  stock Int @default(0)

  featured Boolean @default(false)

  /// Approximate packed contribution of one sellable product unit.
  /// Includes the product container and immediate packaging, but not
  /// the outer shipping package selected for the whole order.
  shippingWeightGrams Int @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([featured])
  @@index([stock])
  @@index([shippingWeightGrams])
  @@index([createdAt])
  @@index([categoryId, createdAt])
  @@index([featured, createdAt])
}

model ShippingPackage {
  id String @id @default(cuid())

  name String
  code String @unique

  lengthCm  Decimal @db.Decimal(8, 2)
  breadthCm Decimal @db.Decimal(8, 2)
  heightCm  Decimal @db.Decimal(8, 2)

  /// Empty package weight, including the outer box
  /// and protective packing material.
  emptyWeightGrams Int @default(0)

  /// Maximum recommended total packed weight.
  maxWeightGrams Int

  active Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([maxWeightGrams])
  @@index([createdAt])
}

model Order {
  id String @id @default(cuid())

  /// Secret token required to access the customer-facing
  /// order confirmation API.
  publicAccessToken String @unique @default(uuid())

  customerName String

  /// Original customer-entered phone number.
  phone String

  /// Digits-only normalized Indian mobile number used for OTP lookup.
  ///
  /// Example:
  /// +91 70138 20854 becomes 7013820854.
  ///
  /// This remains optional until existing orders are backfilled.
  phoneNormalized String?

  email String?

  address String
  city    String
  state   String
  pincode String

  /// Cost of products before shipping.
  subtotalAmount Decimal @default(0) @db.Decimal(10, 2)

  /// Shipping estimate before applying any store-funded discount.
  shippingEstimatedAmount Decimal @default(0) @db.Decimal(10, 2)

  /// Shipping amount actually charged to the customer.
  shippingChargedAmount Decimal @default(0) @db.Decimal(10, 2)

  /// Difference between estimated and charged shipping.
  shippingDiscountAmount Decimal @default(0) @db.Decimal(10, 2)

  /// Final amount paid by the customer.
  totalAmount Decimal @db.Decimal(10, 2)

  status OrderStatus @default(PENDING)

  paymentStatus PaymentStatus @default(PENDING)

  paymentMethod String?

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  shippingProvider ShippingProvider @default(DELHIVERY)
  shippingMode     ShippingMode?
  shipmentStatus   ShipmentStatus   @default(NOT_CREATED)

  /// Selected shipping-package preset.
  packageId String?
  package   ShippingPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  /// Snapshot of the packed shipment values used for this order.
  packageWeightGrams Int?
  packageLengthCm    Decimal? @db.Decimal(8, 2)
  packageBreadthCm   Decimal? @db.Decimal(8, 2)
  packageHeightCm    Decimal? @db.Decimal(8, 2)

  /// Internal carrier shipment data.
  delhiveryWaybill    String? @unique
  delhiveryShipmentId String?
  delhiveryOrderId    String?
  delhiveryStatus     String?

  shippingQuotedAt    DateTime?
  pickupScheduledAt   DateTime?
  shippedAt           DateTime?
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([packageId])
  @@index([phone])
  @@index([phoneNormalized])
  @@index([phoneNormalized, createdAt])
  @@index([pincode])
  @@index([status])
  @@index([paymentStatus])
  @@index([shippingProvider])
  @@index([shippingMode])
  @@index([shipmentStatus])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([shipmentStatus, createdAt])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([delhiveryShipmentId])
  @@index([delhiveryOrderId])
}

model OrderItem {
  id String @id @default(cuid())

  orderId   String
  productId String

  quantity Int
  price    Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([createdAt])
  @@index([orderId, productId])
}

model PhoneOtpChallenge {
  id String @id @default(cuid())

  /// Digits-only normalized Indian mobile number.
  phoneNormalized String

  purpose OtpPurpose @default(ORDER_TRACKING)

  /// Cryptographic hash of the OTP.
  otpHash String

  /// Time after which this OTP is invalid.
  expiresAt DateTime

  /// Number of failed verification attempts.
  attempts Int @default(0)

  /// Maximum number of permitted failed attempts.
  maxAttempts Int @default(5)

  /// Set when the OTP is verified successfully.
  verifiedAt DateTime?

  /// Set when the OTP is exchanged for a tracking session.
  consumedAt DateTime?

  /// Optional hashed request metadata used for abuse prevention.
  requestIpHash String?

  /// Optional hashed browser user-agent data.
  userAgentHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNormalized])
  @@index([phoneNormalized, purpose, createdAt])
  @@index([purpose, createdAt])
  @@index([expiresAt])
  @@index([verifiedAt])
  @@index([consumedAt])
}

model OrderTrackingSession {
  id String @id @default(cuid())

  /// Hash of the random session token sent to the browser.
  tokenHash String @unique

  /// Phone number authorized by OTP verification.
  phoneNormalized String

  /// Time after which this tracking session expires.
  expiresAt DateTime

  /// Allows a session to be disabled without deleting it.
  revokedAt DateTime?

  /// Updated whenever this tracking session is used.
  lastUsedAt DateTime?

  /// ID of the OTP challenge used to create this session.
  sourceChallengeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNormalized])
  @@index([phoneNormalized, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([sourceChallengeId])
  @@index([createdAt])
}

model ContactInquiry {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String?
  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
  @@index([isRead, createdAt])
}
