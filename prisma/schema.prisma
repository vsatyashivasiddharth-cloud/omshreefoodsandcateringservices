generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ShippingProvider {
  DELHIVERY
  MANUAL
}

enum ShippingMode {
  SURFACE
  EXPRESS
}

enum ShipmentStatus {
  NOT_CREATED
  QUOTED
  CREATED
  PICKUP_SCHEDULED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
  CANCELLED
  FAILED
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  phone    String?

  role Role @default(CUSTOMER)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([createdAt])
}

model Admin {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Category {
  id    String  @id @default(cuid())
  name  String
  slug  String  @unique
  image String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
}

model Product {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String

  price Decimal @db.Decimal(10, 2)

  image String

  stock Int @default(0)

  featured Boolean @default(false)

  /// Approximate packed contribution of one unit.
  /// Includes product container and immediate packaging.
  shippingWeightGrams Int @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([featured])
  @@index([stock])
  @@index([shippingWeightGrams])
  @@index([createdAt])
  @@index([categoryId, createdAt])
  @@index([featured, createdAt])
}

model ShippingPackage {
  id String @id @default(cuid())

  name String
  code String @unique

  lengthCm  Decimal @db.Decimal(8, 2)
  breadthCm Decimal @db.Decimal(8, 2)
  heightCm  Decimal @db.Decimal(8, 2)

  /// Empty package weight, including box and protective material.
  emptyWeightGrams Int @default(0)

  /// Maximum recommended packed weight for this box.
  maxWeightGrams Int

  active Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([maxWeightGrams])
  @@index([createdAt])
}

model Order {
  id String @id @default(cuid())

  customerName String
  phone        String
  email        String?

  address String
  city    String
  state   String
  pincode String

  /// Cost of products before shipping.
  subtotalAmount Decimal @default(0) @db.Decimal(10, 2)

  /// Rate returned by Delhivery before applying your discount.
  shippingEstimatedAmount Decimal @default(0) @db.Decimal(10, 2)

  /// Shipping amount actually charged to the customer.
  shippingChargedAmount Decimal @default(0) @db.Decimal(10, 2)

  /// Difference between estimated shipping and customer charge.
  shippingDiscountAmount Decimal @default(0) @db.Decimal(10, 2)

  /// Final customer total:
  /// subtotalAmount + shippingChargedAmount
  totalAmount Decimal @db.Decimal(10, 2)

  status OrderStatus @default(PENDING)

  paymentStatus PaymentStatus @default(PENDING)

  paymentMethod String?

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  shippingProvider ShippingProvider @default(DELHIVERY)
  shippingMode     ShippingMode?
  shipmentStatus   ShipmentStatus   @default(NOT_CREATED)

  /// Selected standard package.
  packageId String?
  package   ShippingPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  /// Package values are copied here so previous orders remain accurate
  /// even if a ShippingPackage preset is edited later.
  packageWeightGrams Int?
  packageLengthCm    Decimal? @db.Decimal(8, 2)
  packageBreadthCm   Decimal? @db.Decimal(8, 2)
  packageHeightCm    Decimal? @db.Decimal(8, 2)

  /// Delhivery shipment information.
  delhiveryWaybill    String? @unique
  delhiveryShipmentId String?
  delhiveryOrderId    String?
  delhiveryStatus     String?

  shippingQuotedAt    DateTime?
  pickupScheduledAt   DateTime?
  shippedAt           DateTime?
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([packageId])
  @@index([phone])
  @@index([pincode])
  @@index([status])
  @@index([paymentStatus])
  @@index([shippingProvider])
  @@index([shippingMode])
  @@index([shipmentStatus])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([shipmentStatus, createdAt])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([delhiveryShipmentId])
  @@index([delhiveryOrderId])
}

model OrderItem {
  id String @id @default(cuid())

  orderId   String
  productId String

  quantity Int
  price    Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([createdAt])
  @@index([orderId, productId])
}

model ContactInquiry {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String?
  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
  @@index([isRead, createdAt])
}
