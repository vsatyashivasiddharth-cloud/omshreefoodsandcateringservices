generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PrintJobType {
  ECOMMERCE_LABEL
}

enum PrintJobStatus {
  PENDING
  PRINTING
  PRINTED
  FAILED
}

enum ShippingProvider {
  DELHIVERY
  MANUAL
}

enum ShippingMode {
  SURFACE
  EXPRESS
}

enum ShipmentStatus {
  NOT_CREATED
  QUOTED
  CREATED
  PICKUP_SCHEDULED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
  CANCELLED
  FAILED
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  phone    String?

  role Role @default(CUSTOMER)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([createdAt])
}

model Admin {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  pushSubscriptions PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model PushSubscription {
  id String @id @default(cuid())

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  /// Browser user-agent snapshot used only to help identify the device.
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
  @@index([createdAt])
}

model Category {
  id    String  @id @default(cuid())
  name  String
  slug  String  @unique
  image String?

  /// Controls whether this category and its products are visible to customers.
  /// Hiding a category does not modify the individual Product.isActive values.
  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
}

model Product {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String

  /// Temporary default-variant price mirror.
  /// Keep this field until all variant-aware flows are deployed.
  price Decimal @db.Decimal(10, 2)

  image String

  /// Temporary default-variant stock mirror.
  /// Keep this field until all variant-aware flows are deployed.
  stock Int @default(0)

  featured Boolean @default(false)

  /// Controls whether this product is available for new customer purchases.
  ///
  /// A product can be temporarily hidden by setting this to false.
  isActive Boolean @default(true)

  /// Approximate packed contribution of one sellable product unit.
  /// During the compatibility period, this mirrors the default
  /// variant's shippingWeightGrams.
  shippingWeightGrams Int @default(0)

  /// Approximate outer dimensions of one packed default product unit.
  ///
  /// These remain nullable during the compatibility period so older
  /// products can continue using weight-only shipping until dimensions
  /// are configured.
  packedLengthCm  Decimal? @db.Decimal(10, 2)
  packedBreadthCm Decimal? @db.Decimal(10, 2)
  packedHeightCm  Decimal? @db.Decimal(10, 2)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([featured])
  @@index([isActive])
  @@index([stock])
  @@index([shippingWeightGrams])
  @@index([createdAt])
  @@index([categoryId, createdAt])
  @@index([featured, createdAt])
  @@index([isActive, createdAt])
  @@index([isActive, categoryId, createdAt])
  @@index([isActive, featured, createdAt])
}

model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Customer-facing package label.
  /// Examples: "250 g", "500 g", "1 kg".
  label String

  /// Customer-facing net package weight.
  /// Examples: 250, 500, 1000.
  weightGrams Int

  /// Packed contribution used for shipping calculations.
  /// This may be greater than weightGrams.
  shippingWeightGrams Int

  /// Approximate outer dimensions of one sellable packed unit.
  ///
  /// These represent the product packet/container before it is placed
  /// into the final shipping carton.
  ///
  /// They are nullable temporarily so existing variants remain compatible
  /// until their real packed dimensions are entered in admin.
  packedLengthCm  Decimal? @db.Decimal(8, 2)
  packedBreadthCm Decimal? @db.Decimal(8, 2)
  packedHeightCm  Decimal? @db.Decimal(8, 2)

  price Decimal @db.Decimal(10, 2)
  stock Int     @default(0)

  sku String? @unique

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, weightGrams])
  @@index([productId])
  @@index([productId, isActive])
  @@index([productId, sortOrder])
  @@index([isActive])
  @@index([stock])
  @@index([createdAt])
}

model ShippingPackage {
  id String @id @default(cuid())

  name String
  code String @unique

  lengthCm  Decimal @db.Decimal(8, 2)
  breadthCm Decimal @db.Decimal(8, 2)
  heightCm  Decimal @db.Decimal(8, 2)

  /// Empty package weight, including the outer box
  /// and protective packing material.
  emptyWeightGrams Int @default(0)

  /// Maximum recommended total packed weight.
  maxWeightGrams Int

  active Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([maxWeightGrams])
  @@index([createdAt])
}

model Order {
  id String @id @default(cuid())

  /// Secret token required to access the customer-facing
  /// order confirmation API.
  publicAccessToken String @unique @default(uuid())

  customerName String

  /// Original customer-entered phone number.
  phone String

  /// Digits-only Indian mobile number used for phone-based tracking.
  phoneNormalized String?

  email String?

  address String
  city    String
  state   String
  pincode String

  /// Cost of products before shipping.
  subtotalAmount Decimal @default(0) @db.Decimal(10, 2)

  /// Shipping estimate before applying any store-funded discount.
  shippingEstimatedAmount Decimal @default(0) @db.Decimal(10, 2)

  /// Shipping amount actually charged to the customer.
  shippingChargedAmount Decimal @default(0) @db.Decimal(10, 2)

  /// Difference between estimated and charged shipping.
  shippingDiscountAmount Decimal @default(0) @db.Decimal(10, 2)

  /// Final amount paid by the customer.
  totalAmount Decimal @db.Decimal(10, 2)

  status OrderStatus @default(PENDING)

  paymentStatus PaymentStatus @default(PENDING)

  /// When staff first acknowledged this paid order.
  staffSeenAt DateTime?

  paymentMethod String?

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  shippingProvider ShippingProvider @default(DELHIVERY)
  shippingMode     ShippingMode?
  shipmentStatus   ShipmentStatus   @default(NOT_CREATED)

  /// Selected shipping-package preset.
  packageId String?
  package   ShippingPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  /// Snapshot of the packed shipment values used for this order.
  packageWeightGrams Int?
  packageLengthCm    Decimal? @db.Decimal(8, 2)
  packageBreadthCm   Decimal? @db.Decimal(8, 2)
  packageHeightCm    Decimal? @db.Decimal(8, 2)

  /// Internal carrier shipment data.
  delhiveryWaybill    String? @unique
  delhiveryShipmentId String?
  delhiveryOrderId    String?
  delhiveryStatus     String?

  shippingQuotedAt    DateTime?
  pickupScheduledAt   DateTime?
  shippedAt           DateTime?
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items     OrderItem[]
  printJobs PrintJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([packageId])
  @@index([phone])
  @@index([phoneNormalized])
  @@index([phoneNormalized, createdAt])
  @@index([pincode])
  @@index([status])
  @@index([paymentStatus])
  @@index([staffSeenAt])
  @@index([shippingProvider])
  @@index([shippingMode])
  @@index([shipmentStatus])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([shipmentStatus, createdAt])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([delhiveryShipmentId])
  @@index([delhiveryOrderId])
}

model OrderItem {
  id String @id @default(cuid())

  orderId   String
  productId String?

  /// Null for orders created before product variants were introduced.
  variantId String?

  quantity Int

  /// Purchase-time unit-price snapshot.
  price Decimal @db.Decimal(10, 2)

  /// Product snapshots for historical order rendering.
  productName  String?
  productSlug  String?
  productImage String?

  /// Variant snapshots for historical order rendering.
  variantLabel               String?
  variantSku                 String?
  variantWeightGrams         Int?
  variantShippingWeightGrams Int?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
  @@index([orderId, productId])
  @@index([orderId, variantId])
}

model PrintJob {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type   PrintJobType
  status PrintJobStatus @default(PENDING)

  /// Number of actual print attempts made by a staff print client.
  attemptCount Int @default(0)

  /// When a print client most recently started processing this job.
  claimedAt DateTime?

  /// When the label was successfully printed.
  printedAt DateTime?

  /// Most recent printer or print-client error.
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Guarantees one automatic ecommerce-label job per order.
  @@unique([orderId, type])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model ContactInquiry {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String?
  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
  @@index([isRead, createdAt])
}

model TrackingLookupAttempt {
  id String @id @default(cuid())

  phoneHash String
  ipHash    String

  createdAt DateTime @default(now())

  @@index([phoneHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
}

/// Persistent rate-limit records for the public
/// Delhivery shipping-quote endpoint.
///
/// Only an HMAC hash of the requester IP is stored.
/// Raw IP addresses are never persisted.
model ShippingQuoteAttempt {
  id String @id @default(cuid())

  ipHash String

  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

model Coupon {
  id String @id @default(cuid())

  /// Exact customer-facing coupon code.
  /// Coupon matching is case-sensitive.
  code String @unique

  /// Percentage discount applied to the product subtotal.
  /// Example: 10.00 represents 10%.
  discountPercent Decimal @db.Decimal(5, 2)

  /// Maximum number of successful redemptions
  /// allowed for this coupon.
  maxUses Int

  /// Allows an administrator to enable or disable
  /// new use of this coupon.
  isActive Boolean @default(true)

  /// When enabled, one normalized mobile number
  /// may redeem this particular coupon only once.
  oneUsePerPhone Boolean @default(true)

  /// Coupon validity window.
  startsAt DateTime
  endsAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
  @@index([isActive, startsAt, endsAt])
  @@index([createdAt])
}
